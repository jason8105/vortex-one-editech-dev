name: Build 64-bit APK

on:
  push:
    branches:
      - main
      - master
  workflow_dispatch:

jobs:
  build-64bit:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3
        with:
          packages: 'platform-tools platforms;android-35 build-tools;35.0.0'

      - name: Accept Android SDK licenses
        run: yes | $ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager --licenses || yes | $ANDROID_HOME/tools/bin/sdkmanager --licenses || true

      - name: Grant execute permission for gradlew
        run: chmod +x ./gradlew

      - name: Build 64-bit Debug APK Only
        run: ./gradlew :app:assembleDebug -Pandroid.injected.build.abi=arm64-v8a --no-daemon --stacktrace

      - name: Align and Stage 64-bit APK
        run: |
          mkdir -p output
          
          # Find the exact app module output
          RAW_APK=$(find app/build/outputs/apk/debug -type f -name "*arm64-v8a*.apk" -o -name "*debug.apk" | head -n 1)
          if [ -z "$RAW_APK" ]; then
            echo "Error: No debug APK found in app/build/outputs/apk/debug!" && exit 1
          fi
          echo "Processing APK: $RAW_APK"

          # Get latest Android build-tools path
          BUILD_TOOLS_DIR=$(ls -d $ANDROID_HOME/build-tools/* | sort -V | tail -n 1)
          
          # Ensure 16 KB page-alignment for Android 15
          "$BUILD_TOOLS_DIR/zipalign" -p -f -v 16 "$RAW_APK" output/app-arm64-v8a-debug.apk

          # Verify V2/V3 signatures
          "$BUILD_TOOLS_DIR/apksigner" verify --verbose output/app-arm64-v8a-debug.apk || true

      - name: Upload 64-bit Debug APK
        uses: actions/upload-artifact@v4
        with:
          name: app-arm64-v8a-debug
          path: output/app-arm64-v8a-debug.apk
          if-no-files-found: error