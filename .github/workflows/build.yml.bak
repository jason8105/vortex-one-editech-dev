name: Build 64-bit APK

on:
  push:
    branches:
      - main
      - master
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build-64bit:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3
        with:
          packages: 'platform-tools platforms;android-35 build-tools;35.0.0'

      - name: Accept Android SDK licenses
        run: yes | $ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager --licenses || true

      - name: Grant execute permission for gradlew
        run: chmod +x ./gradlew

      - name: Build 64-bit Debug APK
        run: ./gradlew :app:assembleDebug -Pandroid.injected.build.abi=arm64-v8a --no-daemon --stacktrace

      - name: Stage APK Output
        run: |
          mkdir -p output
          
          # Target the generated arm64 debug APK from build outputs
          APK_PATH=$(find app/build/outputs/apk/debug -type f -name "*arm64-v8a*.apk" ! -name "*unaligned*" | head -n 1)
          
          # Fallback if splits naming varies
          if [ -z "$APK_PATH" ]; then
            APK_PATH=$(find app/build/outputs/apk -type f -name "*.apk" ! -name "*unaligned*" | grep -E "arm64|debug" | head -n 1)
          fi

          if [ -z "$APK_PATH" ]; then
            echo "Error: No matching APK found in build outputs!"
            exit 1
          fi

          echo "Found APK: $APK_PATH"
          cp "$APK_PATH" output/app-arm64-v8a-debug.apk

      - name: Verify APK with apksigner
        run: |
          BUILD_TOOLS_DIR=$(ls -d $ANDROID_HOME/build-tools/* | sort -V | tail -n 1)
          if [ -f "$BUILD_TOOLS_DIR/apksigner" ]; then
            "$BUILD_TOOLS_DIR/apksigner" verify --verbose output/app-arm64-v8a-debug.apk || true
          fi

      - name: Upload 64-bit Debug APK
        uses: actions/upload-artifact@v4
        with:
          name: app-arm64-v8a-debug
          path: output/app-arm64-v8a-debug.apk
          if-no-files-found: error
